{
  "description": "Answer /account instantly with the cid output, without a model turn, and apply pending automatic account switches before a prompt is sent.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "(^|:)account$",
        "hooks": [
          {
            "type": "command",
            "command": "cid",
            "args": ["hook"],
            "timeout": 660,
            "statusMessage": "cid…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cid",
            "args": ["hook"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
